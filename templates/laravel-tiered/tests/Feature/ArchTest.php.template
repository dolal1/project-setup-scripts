<?php

namespace Tests\Feature;

use PHPUnit\Framework\TestCase;
use RecursiveDirectoryIterator;
use RecursiveIteratorIterator;

/**
 * Core must never reference a tier module. If it did, a release without that module would
 * break at the client's site. Modules plug into core through hooks (App\Support\Menu, ...).
 */
class ArchTest extends TestCase
{
    private const CORE_PATHS = ['app', 'bootstrap', 'config', 'database', 'resources', 'routes', 'tests'];

    public function test_core_never_references_modules(): void
    {
        $root = dirname(__DIR__, 2);
        $tiers = (require $root.'/config/{{PREFIX}}.php')['tiers'];

        // A Modules\ namespace (but not e.g. App\Support\Modules\...), or a module view namespace
        $patterns = ['/(?<![\\\\\w])Modules\\\\/'];
        foreach (array_slice($tiers, 1) as $tier) {
            $patterns[] = '/\b'.preg_quote($tier, '/').'::/';
        }

        $violations = [];
        foreach (self::CORE_PATHS as $path) {
            if (! is_dir("$root/$path")) {
                continue;
            }
            $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator("$root/$path", RecursiveDirectoryIterator::SKIP_DOTS));
            foreach ($files as $file) {
                $relative = substr($file->getPathname(), strlen($root) + 1);
                if ($file->getExtension() !== 'php' || $file->getPathname() === __FILE__
                    || str_starts_with($relative, 'bootstrap/cache/')) {
                    continue;
                }
                $contents = file_get_contents($file->getPathname());
                foreach ($patterns as $pattern) {
                    if (preg_match($pattern, $contents)) {
                        $violations[] = "$relative matches $pattern";
                    }
                }
            }
        }

        $this->assertSame([], $violations, "Core references tier modules:\n".implode("\n", $violations));
    }
}
