<?php

use Illuminate\Support\Facades\Route;

// Loaded only when the {{MODULE}} module loads, so in a lower-tier build these URLs 404.
Route::middleware(['web', 'auth', 'can:{{MODULE_TIER}}.example.view'])
    ->prefix('{{MODULE_TIER}}')
    ->name('{{MODULE_TIER}}.')
    ->group(function () {
        Route::get('/example', fn () => view('{{MODULE_TIER}}::example'))->name('example');
    });
