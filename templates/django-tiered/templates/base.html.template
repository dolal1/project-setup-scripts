{% load tiers %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{PROJECT_NAME}}{% endblock %}</title>
<style>
    body { font: 16px/1.5 system-ui, sans-serif; margin: 0; color: #1f2328; }
    header, main { padding: 12px 20px; }
    .menu ul { list-style: none; padding: 0; display: flex; gap: 16px; }
    .upgrade-hint { color: #5b6470; font-size: 0.9em; }
</style>
</head>
<body>
<header>
    <strong>{{PROJECT_NAME}}</strong>
    {% menu "main" %}
</header>
<main>{% block content %}{% endblock %}</main>
</body>
</html>
