"""Runs at every tier (CI runs the suite once per tier): below {{MODULE_TIER}} the module is inactive
and must leave no trace; at or above it, it must work.
"""
import pytest
from django.conf import settings
from django.db import connection
from django.template import Context, Template

from core import features
from core.permissions import Role

pytestmark = pytest.mark.django_db
URL = "/{{MODULE_TIER}}/example/"


def active() -> bool:
    return settings.TIER_MODULES.has("{{MODULE_TIER}}")


def make_user(django_user_model, role):
    return django_user_model.objects.create_user(username=f"{role}-{{MODULE_TIER}}", password="x" * 12, role=role)


def test_example_page_and_table_follow_the_active_tier(client, django_user_model):
    client.force_login(make_user(django_user_model, Role.ADMIN))

    response = client.get(URL)
    tables = connection.introspection.table_names()

    if active():
        assert response.status_code == 200
        assert b"{{MODULE}} example" in response.content
        assert "{{MODULE_TIER}}_example" in tables
    else:
        assert response.status_code == 404
        assert "{{MODULE_TIER}}_example" not in tables


def test_roles_and_the_feature_switch_control_access(client, django_user_model):
    if not active():
        pytest.skip("{{MODULE}} is not active at this tier.")

    client.force_login(make_user(django_user_model, Role.STAFF))
    assert client.get(URL).status_code == 403

    features.set_active("{{MODULE_TIER}}.example", False)
    client.force_login(make_user(django_user_model, Role.ADMIN))
    assert client.get(URL).status_code == 403


def test_menu_item_appears_only_for_allowed_users(django_user_model):
    def menu_for(role):
        return Template('{% load tiers %}{% menu "main" %}').render(Context({"user": make_user(django_user_model, role)}))

    assert ("{{MODULE}} example" in menu_for(Role.ADMIN)) == active()
    assert "{{MODULE}} example" not in menu_for(Role.STAFF)
