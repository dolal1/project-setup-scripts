#!/bin/bash

# Development and testing script for {{PROJECT_NAME}}

set -e

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Help function
show_help() {
    echo "{{PROJECT_NAME}} Development Script"
    echo ""
    echo "Usage: ./scripts.sh [COMMAND]"
    echo ""
    echo "Commands:"
    echo "  test        Run all tests"
    echo "  test-be     Run backend tests only"
    echo "  test-fe     Run frontend tests only"
    echo "  quality     Run code quality checks"
    echo "  security    Run security scans"
    echo "  format      Format code"
    echo "  lint        Lint code"
    echo "  build       Build for production"
    echo "  clean       Clean build artifacts"
    echo "  all         Run tests, quality, and security checks"
    echo "  help        Show this help message"
}

# Test functions
run_backend_tests() {
    print_info "Running backend tests..."
    cd backend
    if [ -d "{{VENV_NAME}}" ]; then
        source {{VENV_NAME}}/bin/activate
        pytest --cov --cov-report=term-missing
        deactivate
    else
        docker-compose exec backend pytest --cov
    fi
    cd ..
    print_success "Backend tests completed"
}

run_frontend_tests() {
    print_info "Running frontend tests..."
    cd frontend
    npm run test
    cd ..
    print_success "Frontend tests completed"
}

# Quality functions
run_backend_quality() {
    print_info "Running backend quality checks..."
    cd backend
    if [ -d "{{VENV_NAME}}" ]; then
        source {{VENV_NAME}}/bin/activate
        black --check .
        isort --check-only .
        ruff check .
        mypy .
        deactivate
    else
        docker-compose exec backend black --check .
        docker-compose exec backend isort --check-only .
        docker-compose exec backend ruff check .
        docker-compose exec backend mypy .
    fi
    cd ..
    print_success "Backend quality checks completed"
}

run_frontend_quality() {
    print_info "Running frontend quality checks..."
    cd frontend
    npm run lint
    npm run type-check
    cd ..
    print_success "Frontend quality checks completed"
}

# Security functions
run_security_scans() {
    print_info "Running security scans..."
    
    # Backend security
    print_info "Scanning backend for security issues..."
    cd backend
    if [ -d "{{VENV_NAME}}" ]; then
        source {{VENV_NAME}}/bin/activate
        bandit -r . -f json -o bandit-report.json || true
        safety check || true
        deactivate
    fi
    cd ..
    
    # Frontend security
    print_info "Scanning frontend for security issues..."
    cd frontend
    npm audit || true
    cd ..
    
    # Container security
    if command -v trivy &> /dev/null; then
        print_info "Scanning containers for vulnerabilities..."
        trivy image --exit-code 0 {{PROJECT_NAME}}_backend || true
        trivy image --exit-code 0 {{PROJECT_NAME}}_frontend || true
    fi
    
    # Secret detection
    if command -v trufflehog &> /dev/null; then
        print_info "Scanning for secrets..."
        trufflehog --regex --entropy=False . || true
    fi
    
    print_success "Security scans completed"
}

# Format functions
format_code() {
    print_info "Formatting code..."
    
    # Backend formatting
    cd backend
    if [ -d "{{VENV_NAME}}" ]; then
        source {{VENV_NAME}}/bin/activate
        black .
        isort .
        deactivate
    else
        docker-compose exec backend black .
        docker-compose exec backend isort .
    fi
    cd ..
    
    # Frontend formatting
    cd frontend
    npm run format
    cd ..
    
    print_success "Code formatting completed"
}

# Lint functions
lint_code() {
    print_info "Linting code..."
    
    # Backend linting
    cd backend
    if [ -d "{{VENV_NAME}}" ]; then
        source {{VENV_NAME}}/bin/activate
        ruff check . --fix
        deactivate
    else
        docker-compose exec backend ruff check . --fix
    fi
    cd ..
    
    # Frontend linting
    cd frontend
    npm run lint -- --fix
    cd ..
    
    print_success "Code linting completed"
}

# Build functions
build_production() {
    print_info "Building for production..."
    
    # Build frontend
    cd frontend
    npm run build
    cd ..
    
    # Build Docker images for production
    docker-compose -f docker-compose.prod.yml build
    
    print_success "Production build completed"
}

# Clean functions
clean_artifacts() {
    print_info "Cleaning build artifacts..."
    
    # Clean Python cache
    find . -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
    find . -type f -name "*.pyc" -delete 2>/dev/null || true
    
    # Clean frontend
    cd frontend
    rm -rf dist/ node_modules/.cache/
    cd ..
    
    # Clean Docker
    docker system prune -f
    
    print_success "Cleanup completed"
}

# Main command handling
case "$1" in
    "test")
        run_backend_tests
        run_frontend_tests
        ;;
    "test-be")
        run_backend_tests
        ;;
    "test-fe")
        run_frontend_tests
        ;;
    "quality")
        run_backend_quality
        run_frontend_quality
        ;;
    "security")
        run_security_scans
        ;;
    "format")
        format_code
        ;;
    "lint")
        lint_code
        ;;
    "build")
        build_production
        ;;
    "clean")
        clean_artifacts
        ;;
    "all")
        print_info "Running comprehensive checks..."
        run_backend_tests
        run_frontend_tests
        run_backend_quality
        run_frontend_quality
        run_security_scans
        print_success "All checks completed!"
        ;;
    "help"|"--help"|"-h")
        show_help
        ;;
    "")
        print_error "No command specified"
        show_help
        exit 1
        ;;
    *)
        print_error "Unknown command: $1"
        show_help
        exit 1
        ;;
esac