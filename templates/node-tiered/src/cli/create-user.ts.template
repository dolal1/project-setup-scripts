// npm run create-user -- <username> <admin|staff>   (asks for the password)
import { createInterface } from "node:readline/promises";
import { createApp } from "../app.js";
import { createUser } from "../support/auth.js";
import { Role } from "../support/permissions.js";

const [username, role = Role.Staff] = process.argv.slice(2);
if (!username || !Object.values(Role).includes(role as Role)) {
  console.error(`Usage: npm run create-user -- <username> <${Object.values(Role).join("|")}>`);
  process.exit(1);
}

const rl = createInterface({ input: process.stdin, output: process.stdout });
const password = await rl.question("Password (at least 10 characters): ");
rl.close();
if (password.length < 10) {
  console.error("The password must be at least 10 characters.");
  process.exit(1);
}

const app = await createApp();
await createUser(app.locals.db, username, password, role as Role);
console.log(`Created ${role} '${username}'.`);
await app.locals.db.destroy();
