import { existsSync } from "node:fs";
import { join } from "node:path";
import { APP_ROOT } from "./paths.js";

// Node 22 reads .env natively; real environment variables win over the file
const envFile = join(APP_ROOT, ".env");
if (existsSync(envFile)) {
  process.loadEnvFile(envFile);
}

// Every tier, lowest first. The first is core (src/); each later one is modules/<tier>/.
export const TIERS = [{{TIERS_TS}}];

export const config = {
  // Development defaults to the top tier. A client release writes the client's tier to .env.example.
  tier: process.env.{{PREFIX_UPPER}}_TIER ?? "{{TOP_TIER}}",
  port: Number(process.env.PORT ?? 3000),
  sessionSecret: process.env.SESSION_SECRET ?? "{{DEV_SESSION_SECRET}}",
  production: process.env.NODE_ENV === "production",
  db: {
    client: process.env.DB_CLIENT ?? "better-sqlite3",
    filename: process.env.DB_FILENAME ?? join(APP_ROOT, "data", "app.sqlite"),
    host: process.env.DB_HOST,
    port: process.env.DB_PORT ? Number(process.env.DB_PORT) : undefined,
    user: process.env.DB_USER,
    password: process.env.DB_PASSWORD,
    database: process.env.DB_NAME,
  },
};
