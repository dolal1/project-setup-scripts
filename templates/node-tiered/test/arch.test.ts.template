/**
 * Core must never reference a tier module. If it did, a release without that module would break at
 * the client's site. Modules plug into core through hooks (Menu, Permissions, Features, the router).
 */
import { readdirSync, readFileSync, statSync } from "node:fs";
import { join, relative } from "node:path";
import { fileURLToPath } from "node:url";
import { expect, test } from "vitest";
import { TIERS } from "../src/config/env.js";

const ROOT = join(fileURLToPath(import.meta.url), "../..");
const CORE_PATHS = ["src", "views", "test"];

function files(dir: string): string[] {
  return readdirSync(dir).flatMap((name) => {
    const path = join(dir, name);
    return statSync(path).isDirectory() ? files(path) : [path];
  });
}

test("core never references modules", () => {
  // An import from modules/, a tier module's folder, or a module's view folder
  const patterns = [/(from\s+|import\s*\()\s*["'][^"']*\bmodules\//];
  for (const tier of TIERS.slice(1)) {
    patterns.push(new RegExp(`\\bmodules/${tier}\\b`), new RegExp(`["']${tier}/`));
  }

  const violations: string[] = [];
  for (const base of CORE_PATHS) {
    for (const file of files(join(ROOT, base))) {
      if (!/\.(ts|ejs)$/.test(file) || file === fileURLToPath(import.meta.url)) continue;
      const text = readFileSync(file, "utf8");
      for (const pattern of patterns) {
        if (pattern.test(text)) violations.push(`${relative(ROOT, file)} matches ${pattern}`);
      }
    }
  }

  expect(violations, `Core references tier modules:\n${violations.join("\n")}`).toEqual([]);
});
